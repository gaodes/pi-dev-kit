{
	"name": "pi-tools",
	"version": "0.1.1",
	"description": "Runtime tools for Pi — version, docs, changelog, updater, package manager, and extension benchmarking",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"tools",
		"dev-kit"
	],
	"type": "module",
	"main": "./src/index.ts",
