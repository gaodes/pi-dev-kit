	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*",
		"@mariozechner/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@mariozechner/pi-coding-agent": {
			"optional": true
		},
		"@mariozechner/pi-tui": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
