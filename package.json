{
	"name": "pi-dev-kit",
	"version": "0.2.0",
	"description": "Developer toolkit for Pi — version, docs, changelog, extension benchmarking, and loaded tools listing",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"dev-kit",
		"tools"
	],
